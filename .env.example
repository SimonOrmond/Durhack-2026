# Copy to .env and fill in. .env is gitignored.
# MongoDB Atlas connection string (Database > Connect > Drivers). Leave unset to use an
# in-memory MongoDB for local dev (data is lost when the server stops).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=physio
PORT=5173

# ---- Prescription emails (Gmail) ----
# GMAIL_USER: sending Gmail address. GMAIL_APP_PASSWORD: 16-char App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification). EMAIL_TO: send all
# emails here instead of the patient's own address (demo mode). Blank = emails off.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
EMAIL_TO=you@gmail.com
APP_URL=http://localhost:5173
